# RailRoute Optimizer — environment template.
# Copy to `.env` (untracked) and fill in values. NEVER commit `.env` or put secrets in source files.
# All variables are read by the backend through app/core/config.py (pydantic-settings).
# The same file configures both run modes: `make backend` reads it directly, and
# `docker compose --profile app` forwards every application setting from it to the backend
# container (compose.yaml; docs/08 D-30). Unset variables use the defaults in config.py.
# Keep comments on their own lines: Docker Compose treats "KEY=   # text" as the value "# text".

# === PostgreSQL ================================================================================
# Used by compose.yaml. The runtime role is created by infrastructure/postgres/initdb on first start.
POSTGRES_ADMIN_USER=railroute_admin
POSTGRES_ADMIN_PASSWORD=change-me-admin-password
POSTGRES_DB=railroute
POSTGRES_APP_USER=railroute_app
POSTGRES_APP_PASSWORD=change-me-app-password

# Runtime connection (least-privileged role). `postgresql://` is accepted and upgraded to psycopg.
DATABASE_URL=postgresql+psycopg://railroute_app:change-me-app-password@localhost:5432/railroute

# Connection pool of the backend process (per replica).
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# Optional schema-owner URL for Alembic. If unset it is derived from DATABASE_URL using
# POSTGRES_ADMIN_USER / POSTGRES_ADMIN_PASSWORD (falls back to DATABASE_URL).
# MIGRATION_DATABASE_URL=postgresql+psycopg://railroute_admin:change-me-admin-password@localhost:5432/railroute

# Host ports published by compose.yaml (change if PostgreSQL/Redis already run natively).
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# === Redis =====================================================================================
# Cache, single-flight locks, provider quota counters, API rate limits.
# Empty = in-process store (single instance; development/demo only).
REDIS_URL=redis://localhost:6379/0

# === Application ===============================================================================
# development | test | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the API whose X-Forwarded-For entries are trusted.
# 0 when running the API directly; the Compose `app` profile uses COMPOSE_TRUSTED_PROXY_HOPS (default 1)
# because the backend sits behind the Next.js proxy there. See docs/10_OPERATIONS_RUNBOOK.md.
TRUSTED_PROXY_HOPS=0
MAX_REQUEST_BODY_BYTES=65536

# === Railway provider ==========================================================================
# mock = clearly labelled demo data | railkit = live RailKit API
RAILWAY_PROVIDER=mock
# Server-side only. Required when RAILWAY_PROVIDER=railkit.
RAILKIT_API_KEY=
RAILKIT_BASE_URL=https://api.railkit.in
RAILKIT_CONNECT_TIMEOUT_SECONDS=5
RAILKIT_READ_TIMEOUT_SECONDS=20
RAILKIT_WRITE_TIMEOUT_SECONDS=5
RAILKIT_POOL_TIMEOUT_SECONDS=5
# Retries apply to timeouts / 5xx only. Every attempt counts against the quota guard, and during a
# journey search every retry is also paid from that search's request budget (docs/08 D-28).
RAILKIT_MAX_RETRIES=1
RAILKIT_RETRY_BACKOFF_SECONDS=0.5
# Concurrent provider requests per backend process; also the size of one search query wave.
RAILKIT_MAX_CONCURRENCY=4
# Inferred from RailKit docs (₹); verify (docs/09 Q9).
RAILKIT_FARE_CURRENCY=INR
# Quotas RailKit seat availability accepts (TQ verified 2026-11-15, docs/09 Q16). Must include GN;
# remove TQ to disable Tatkal.
RAILKIT_SUPPORTED_QUOTAS=GN,TQ

# === Provider quota guard ======================================================================
# Set to YOUR RailKit plan. Defaults = Free tier.
#   Free: 50/month, 100 per 10 min | Pro: 5000/month, 200 per 10 min | Advance: 10000/month, 600 per 10 min
PROVIDER_MONTHLY_REQUEST_LIMIT=50
PROVIDER_WINDOW_REQUEST_LIMIT=100
PROVIDER_WINDOW_SECONDS=600
PROVIDER_RATE_LIMIT_BACKOFF_SECONDS=300

# === Search policy =============================================================================
SUPPORTED_CLASSES=1A,2A,3A,3E,SL,CC,EC,2S
# Hard maximum is 4 (binding product decision); may only be lowered.
MAX_SEGMENTS=4
# Trains a user may select per search. The train list starts with none selected.
SEARCH_MAX_TRAINS=5
# Classes per search. Every train x class x quota is a separate combination sharing the budget:
# 5 trains x 3 classes x 2 quotas = 30 = the default budget, so every direct ticket can be checked.
SEARCH_MAX_CLASSES=3
# Provider availability ATTEMPTS per search, retries included (cache hits are free). Every
# combination's direct ticket is checked first; what is left looks for split tickets (D-27, D-28).
SEARCH_MAX_AVAILABILITY_REQUESTS=30
SEARCH_DEADLINE_SECONDS=90
PLANNER_MAX_INTERMEDIATE_STOPS=30
# Results shown: the top N of the existing ranking (also bounds how deep a search must go).
MAX_RECOMMENDATIONS=10
MAX_PATHS_PER_COMBINATION=50
# SEGMENT_BOARDING_DATE (verified against RailKit 2026-11-14) | TRAIN_START_DATE — docs/09 Q1.
AVAILABILITY_DATE_POLICY=SEGMENT_BOARDING_DATE
MAX_ADVANCE_BOOKING_DAYS=60
# async = 202 + polling | sync = inline (tests/dev)
SEARCH_EXECUTION_MODE=async
MAX_CONCURRENT_SEARCHES=4
# On shutdown (e.g. a deploy), let running searches finish for up to this many seconds before
# cancelling them. 0 = cancel immediately. Production: ~95 (> SEARCH_DEADLINE_SECONDS) and below
# the platform's kill timeout (Render maxShutdownDelaySeconds = 120 in render.yaml).
SEARCH_SHUTDOWN_GRACE_SECONDS=0

# === Daily IRCTC maintenance window (docs/08 D-31) =============================================
# IRCTC allows no train search / seat availability check between these IST wall-clock times; the
# API refuses train lookups, route searches and availability checks then (HTTP 503). The window
# may cross midnight. Stored results stay available. Set ENABLED=false only for testing.
RAILWAY_MAINTENANCE_ENABLED=true
RAILWAY_MAINTENANCE_START=23:45
RAILWAY_MAINTENANCE_END=00:20

# === Reservation quota booking windows (docs/08 D-21) ==========================================
# Tatkal opens N calendar days before the train's ORIGIN date (not the boarding date), at an IST
# wall-clock time (HH:MM, no offset) that depends on the class category.
TATKAL_OPENING_DAYS_BEFORE=1
TATKAL_AC_OPENING_TIME=10:00
TATKAL_NON_AC_OPENING_TIME=11:00

# === Cache TTLs (seconds) ======================================================================
# PENDING RailKit caching/storage agreement (docs/09 Q14). Keep conservative.
AVAILABILITY_CACHE_TTL_SECONDS=120
TRAIN_SEARCH_CACHE_TTL_SECONDS=1800
TRAIN_ROUTE_CACHE_TTL_SECONDS=86400
STATION_SEARCH_CACHE_TTL_SECONDS=604800
SINGLE_FLIGHT_LOCK_TTL_SECONDS=60
STALE_AFTER_SECONDS=300
STATION_SEARCH_MIN_QUERY_LENGTH=3

# === Public API rate limits (per client IP, fixed window) ======================================
API_RATE_LIMIT_WINDOW_SECONDS=600
# Journey optimize + direct availability checks.
API_RATE_LIMIT_SEARCH_REQUESTS=20
# Station search, train search, train route.
API_RATE_LIMIT_LOOKUP_REQUESTS=300

# === Observability =============================================================================
METRICS_ENABLED=true
# Bearer token for GET /api/v1/metrics. Required outside development (endpoint disabled if empty).
METRICS_TOKEN=

# === Mock provider =============================================================================
MOCK_LATENCY_MS=120

# === Frontend (Next.js server only; never exposed to the browser) ==============================
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# === Tests (optional) ==========================================================================
# TEST_DATABASE_URL=postgresql+psycopg://railroute_admin:change-me-admin-password@localhost:5432/railroute_test
# TEST_REDIS_URL=redis://localhost:6379/15
# Spends real RailKit quota; see docs/09 §5.
# RUN_LIVE_RAILKIT_TESTS=true
